{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Speakerdesk",
  "version": "0.6.2",
  "identifier": "com.speakerdesk.desktop",
  "plugins": {
    "updater": {
      "endpoints": [
        "https://rootandruntime.com/downloads/speakerdesk/updater/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdERkFCNDE4OTY5RjUzOTYKUldTV1U1K1dHTFQ2Zlh3bStBV0hkZ2FUYkpzd0hNQ1hoU0crTk1Wb1RKdjVUVzRscHkrQ051TlQK",
      "requireSignedVersion": true,
      "allowDowngrades": false
    }
  },
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; script-src 'self'",
      "capabilities": []
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "externalBin": [
      "binaries/speakerdesk-runtime"
    ],
    "macOS": {
      "minimumSystemVersion": "15.0",
      "infoPlist": "Info.plist",
      "entitlements": "Entitlements.plist"
    },
    "shortDescription": "Private transcription and speaker labeling",
    "category": "Productivity",
    "icon": [
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "resources": {
      "../capture/speakerdesk-capture": "speakerdesk-capture"
    }
  }
}
